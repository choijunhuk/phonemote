# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# local TLS certificates / private keys (NEVER commit)
certs/
*.pem
*.key
*.crt
*.p12
*.pfx

# env
.env
.env.*
!.env.example

# logs / caches
*.log
npm-debug.log*
pnpm-debug.log*
.vite/
coverage/
.vitest/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# root CA copy published to the phone by scripts/setup-certs.sh
apps/controller/public/rootCA.crt

apps/controller/public/rootCA-der.crt

# recorded sessions are throwaway; the committed corpus under traces/corpus is not
traces/*
!traces/corpus/

# recorded measurement sessions
logs/
