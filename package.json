{
  "name": "phonemote",
  "version": "0.0.0",
  "private": true,
  "description": "Use an Android phone as a Wii-style motion controller for browser games on a PC",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "setup:certs": "bash scripts/setup-certs.sh",
    "build": "pnpm -r build",
    "play": "pnpm --filter @phonemote/controller build && pnpm -r --parallel play",
    "build:web": "pnpm --filter @phonemote/game build:web && pnpm --filter @phonemote/controller build:web",
    "web": "pnpm build:web && pnpm --filter @phonemote/game preview:web",
    "test:e2e": "pnpm build:web && pnpm --filter @phonemote/game test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
