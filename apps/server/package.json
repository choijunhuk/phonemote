{
  "name": "@phonemote/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "cert-hosts": "tsx src/certHosts.ts",
    "throughput": "tsx src/throughput.ts",
    "play": "tsx src/index.ts",
    "corpus": "tsx src/makeCorpus.ts",
    "record": "tsx src/index.ts --record",
    "axis": "tsx src/readAxisLog.ts",
    "trace-from-log": "tsx src/traceFromLog.ts",
    "cloud": "tsx src/cloud/cloud.ts",
    "bundle:cloud": "esbuild src/cloud/cloud.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/cloud.cjs --external:bufferutil --external:utf-8-validate"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "tsx": "^4.23.12"
  },
  "dependencies": {
    "@phonemote/protocol": "workspace:*",
    "ws": "^8.21.3"
  }
}
